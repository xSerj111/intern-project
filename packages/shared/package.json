{
  "name": "@repo/shared",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@repo/contracts": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jsonwebtoken": "^9.0.3",
    "prom-client": "^15.1.3",
    "typeorm": "^1.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/index.ts",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "branches": 60
      }
    }
  }
}
