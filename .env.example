# Database Configuration
DATABASE_URL=postgresql://innogram_user:innogram_password@localhost:5432/innogram
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=innogram_user
POSTGRES_PASSWORD=innogram_password
POSTGRES_DB=innogram

# Consumed by Docker init script
DB_NAME_AUTH=innogram_auth
DB_NAME_CORE=innogram_core
DB_NAME_NOTIFICATIONS=innogram_notifications

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Application URLs
CORE_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3002
NOTIFICATIONS_SERVICE_URL=http://localhost:3003
CLIENT_URL=http://localhost:3000
CLIENT_PORT=3000

# Message Broker
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_DEFAULT_USER=innogram
RABBITMQ_DEFAULT_PASS=innogram_password
KAFKA_BROKERS=localhost:9092

# Cloud Storage AWS S3 MINIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=innogram-assets
S3_REGION=us-east-1 # Domyślny region wymagany przez AWS SDK
S3_USE_SSL=false

# Development
NODE_ENV=development
LOG_LEVEL=debug

# Crypto
BCRYPT_SALT_ROUNDS=11

# App
AUTH_ALLOWED_ORIGINS=http://localhost:3000