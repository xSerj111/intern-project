# Copy to .env (gitignored) and fill in. Every variable is read from this one root file.
# Each entry says whether it is required or optional. "Default" is what the code uses when the
# variable is unset; an empty value counts as unset.
# Per-service requirements: core = RABBITMQ_URL, S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY,
# S3_PRIVATE_BUCKET_NAME, JWT_SECRET, INTERNAL_API_TOKEN. Notifications = RABBITMQ_URL, JWT_SECRET,
# INTERNAL_API_TOKEN, AUTH_INTERNAL_URL, CLIENT_URL, SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_FROM.
# Auth = CORE_SERVICE_URL, AUTH_ALLOWED_ORIGINS (+ JWT secrets, see below).

# ---------------------------------------------------------------------------
# Shared infrastructure
# ---------------------------------------------------------------------------

# PostgreSQL. Optional, default POSTGRES_HOST=localhost, POSTGRES_PORT=5432 (all services).
# Credential defaults differ per service: core/notifications use postgres/postgres,
# auth uses innogram_user/innogram_password.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=innogram_user
POSTGRES_PASSWORD=innogram_password
# Compose only: initial database created by the postgres container. Apps do not read it.
POSTGRES_DB=innogram

# One database per service. Optional; defaults innogram_auth / innogram_core / innogram_notifications.
# Compose init script creates them; the apps read them (auth, core, notifications) and the CLI data sources.
DB_NAME_AUTH=innogram_auth
DB_NAME_CORE=innogram_core
DB_NAME_NOTIFICATIONS=innogram_notifications

# Redis for auth sessions and token blacklists (auth) and the access-token blacklist (core).
# Optional, default localhost:6379, empty password. Core fails closed (503) when this Redis is down.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Separate Redis used only by core's response cache (not the session Redis above).
# Optional, default localhost:6380. Cache errors are misses, never request errors.
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6380

# RabbitMQ. Required by core and notifications. Credentials must match RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS.
RABBITMQ_URL=amqp://innogram:innogram_password@localhost:5672
# Compose only: broker user and password created by the rabbitmq container.
RABBITMQ_DEFAULT_USER=innogram
RABBITMQ_DEFAULT_PASS=innogram_password

# ---------------------------------------------------------------------------
# Shared secrets
# ---------------------------------------------------------------------------

# Required by core and notifications (startup fails without it). Required by auth in production.
# Auth refuses these two placeholder values, and any value under 32 characters, when NODE_ENV=production.
# KEEP these two lines byte-identical to the placeholders auth checks against (apps/auth_microservice/src/config/env.ts).
JWT_SECRET=your-super-secret-jwt-key-here
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-here
# Auth. Optional, defaults 15m and 7d.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Shared secret for /internal/* calls (auth -> core, notifications -> auth, and the internal
# /health/details and /metrics endpoints). Required by core, auth and notifications; 32+ characters.
# Must be identical across all three. Core, notifications and auth never start without it.
INTERNAL_API_TOKEN=change-me-to-32+-random-characters

# ---------------------------------------------------------------------------
# Service ports and URLs (also read by the Next.js client)
# ---------------------------------------------------------------------------

# Each service has its own port variable, never a shared PORT. Optional; defaults shown.
CORE_PORT=3001
AUTH_PORT=3002
NOTIFICATIONS_PORT=3003
CLIENT_PORT=3000

# Base URLs. CORE_SERVICE_URL is required by auth; the three *_SERVICE_URL values are required by the
# client production build (next.config.ts fails a NODE_ENV=production build without them, and only warns in dev). CLIENT_URL is required by notifications
# and optional in core (default http://localhost:3000); core uses it for CORS. Auth also uses
# AUTH_SERVICE_URL (optional, default http://localhost:AUTH_PORT) as its OpenAPI server URL.
CORE_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3002
NOTIFICATIONS_SERVICE_URL=http://localhost:3003
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Core (NestJS)
# ---------------------------------------------------------------------------

# S3-compatible storage for core assets. docker-compose runs SeaweedFS.
# S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY and S3_PRIVATE_BUCKET_NAME are required by core.
S3_ENDPOINT=localhost
S3_PORT=9000
# Compose only, besides the app: the credentials the seaweedfs container is started with.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Optional, default innogram-assets.
S3_BUCKET_NAME=innogram-assets
# Required. Private bucket (no anonymous policy); attachments are served via presigned URLs.
S3_PRIVATE_BUCKET_NAME=innogram-private
# Optional: public host used in presigned/public URLs; defaults to S3_ENDPOINT when empty.
S3_PUBLIC_ENDPOINT=
# Optional, default us-east-1. Required by the AWS SDK; any value works with SeaweedFS.
S3_REGION=us-east-1
# Optional, default false (true | false).
S3_USE_SSL=false

# Upload presigned-link lifetime and orphaned-upload sweeper timings (seconds). Optional.
# Tests shorten these. Defaults 300 / 3600 (grace, must be >= 0) / 900.
UPLOAD_LINK_TTL_SEC=300
UPLOAD_SWEEP_GRACE_SEC=3600
UPLOAD_SWEEP_INTERVAL_SEC=900

# Transactional outbox: failed attempts before a row is dead-lettered. Optional, default 10.
# OUTBOX_MAX_ATTEMPTS=10

# Name of core's realtime-relay queue (notification.# binding). Optional, default core.realtime-relay.
# Tests use a unique name for isolation; leave unset otherwise.
# NOTIFICATIONS_RELAY_QUEUE=core.realtime-relay

# Queries slower than this (ms) are logged by core. Optional, default 200.
SLOW_QUERY_MS=200
# Optional, default false (true | false). Enables per-request measurement only;
# core refuses to start with it in production.
PERF_INSTRUMENTATION=false

# ---------------------------------------------------------------------------
# Auth (Express)
# ---------------------------------------------------------------------------

# Internal-only auth listener (session/revocation calls from core, contact lookup from notifications).
# Optional, defaults 3012 and 127.0.0.1. Inside containers set the host to 0.0.0.0 and never publish the port.
AUTH_INTERNAL_PORT=3012
AUTH_INTERNAL_HOST=127.0.0.1
# Required by notifications: where it reaches auth's internal listener. In docker-compose use
# http://<auth service>:3012 (with AUTH_INTERNAL_HOST=0.0.0.0 on auth).
AUTH_INTERNAL_URL=http://localhost:3012

# Required by auth: comma-separated origins allowed for credentialed CORS (the client origin).
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Optional, default strict. SameSite of the httpOnly refresh_token cookie: strict | lax | none.
# Use none only when client and auth are on different sites (requires NODE_ENV=production for Secure).
# AUTH_COOKIE_SAMESITE=strict

# Optional, default 10 (the example sets 11). bcrypt cost factor for password hashing.
BCRYPT_SALT_ROUNDS=11

# Google OAuth client ID. Optional; auth falls back to a placeholder. The client reads it too.
GOOGLE_CLIENT_ID=your-google-client-id

# ---------------------------------------------------------------------------
# Notifications (NestJS)
# ---------------------------------------------------------------------------

# Email (SMTP). SMTP_HOST, SMTP_PORT, SMTP_SECURE and SMTP_FROM are required by notifications.
# Defaults target the local Mailpit container (docker-compose). For a real provider, change host/port and set SMTP_USER/SMTP_PASS.
SMTP_HOST=localhost
# Required, integer 1-65535. Mailpit listens on 1025.
SMTP_PORT=1025
# Required, true | false. false for Mailpit.
SMTP_SECURE=false
# Required, sender address shown to recipients.
SMTP_FROM="Innogram <no-reply@innogram.local>"
# Optional, default none. Leave empty for Mailpit.
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Client (Next.js)
# ---------------------------------------------------------------------------

# The client reads the *_SERVICE_URL, CLIENT_PORT and GOOGLE_CLIENT_ID values above and maps them to
# NEXT_PUBLIC_* in next.config.ts. Do not set NEXT_PUBLIC_* in .env.

# ---------------------------------------------------------------------------
# Monitoring (optional, docker compose --profile monitoring)
# ---------------------------------------------------------------------------

# The Prometheus entrypoint reads INTERNAL_API_TOKEN (above) to authenticate scrapes of /metrics;
# it refuses to start without it.

# Required for the monitoring profile: Grafana admin password (Grafana refuses to start when empty).
GRAFANA_ADMIN_PASSWORD=change-me

# Optional. Scrape targets, comma-separated `host:port` or `name=host:port`.
# PROMETHEUS_TARGETS=host.docker.internal:3001,host.docker.internal:3002,host.docker.internal:3003

# ---------------------------------------------------------------------------
# Local performance scripts (k6 and load helpers under apps/core_microservice/test/load)
# ---------------------------------------------------------------------------

# Optional. Base URLs and seed password for npm run perf*. Defaults: localhost:3001 / localhost:3002 / PerfPassword123!
# CORE_URL=http://localhost:3001
# AUTH_URL=http://localhost:3002
# PERF_PASSWORD=PerfPassword123!

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Optional, default development. production enables the stricter checks described above.
NODE_ENV=development

# Optional, all backends: debug|info|warn|error; default info in production, debug otherwise.
# LOG_LEVEL=debug

# Optional, all backends: serve Swagger UI and the OpenAPI JSON; default true unless NODE_ENV=production.
# SWAGGER_ENABLED=true
