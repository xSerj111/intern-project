# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=innogram_user
POSTGRES_PASSWORD=innogram_password
POSTGRES_DB=innogram

# Consumed by Docker init script
DB_NAME_AUTH=innogram_auth
DB_NAME_CORE=innogram_core
DB_NAME_NOTIFICATIONS=innogram_notifications

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email Configuration
# Defaults target the local Mailpit container (docker-compose). For a real provider, change host/port and set SMTP_USER/SMTP_PASS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Innogram <no-reply@innogram.local>"
SMTP_USER=
SMTP_PASS=

# Application URLs
CORE_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3002
NOTIFICATIONS_SERVICE_URL=http://localhost:3003
CLIENT_URL=http://localhost:3000
CLIENT_PORT=3000

# Message Broker
# Credentials must match RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS below
RABBITMQ_URL=amqp://innogram:innogram_password@localhost:5672
RABBITMQ_DEFAULT_USER=innogram
RABBITMQ_DEFAULT_PASS=innogram_password

# Internal API (auth -> core, never public)
# Shared secret for /internal/* calls. Use 32+ random characters.
# Read by core, auth and notifications; the value must be identical across all three.
INTERNAL_API_TOKEN=change-me-to-32+-random-characters
# Internal-only auth listener (session/revocation calls from core)
AUTH_INTERNAL_PORT=3012
# 0.0.0.0 inside containers; never publish or proxy this port
AUTH_INTERNAL_HOST=127.0.0.1
# Where notifications reaches auth's internal listener. In docker-compose use
# http://<auth service>:3012 (with AUTH_INTERNAL_HOST=0.0.0.0 on auth)
AUTH_INTERNAL_URL=http://localhost:3012

# S3-compatible storage. docker-compose runs SeaweedFS; S3_ACCESS_KEY / S3_SECRET_KEY
# are the credentials that container is started with.
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=innogram-assets
# Private bucket (no anonymous policy); attachments are served via presigned URLs
S3_PRIVATE_BUCKET_NAME=innogram-private
# Optional: public host used in presigned/public URLs; defaults to S3_ENDPOINT when empty
S3_PUBLIC_ENDPOINT=
# Required by the AWS SDK; any value works with SeaweedFS
S3_REGION=us-east-1
S3_USE_SSL=false

# Core performance and observability
# Separate Redis instance used by core's cache layer (not the auth/session Redis above)
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6380
# Queries slower than this (ms) are logged by core
SLOW_QUERY_MS=200
# Enables per-request measurement only; core refuses to start with it in production
PERF_INSTRUMENTATION=false
# Upload presigned-link lifetime and orphaned-upload sweeper timings (seconds). Tests shorten these.
UPLOAD_LINK_TTL_SEC=300
UPLOAD_SWEEP_GRACE_SEC=3600
UPLOAD_SWEEP_INTERVAL_SEC=900

# Development
NODE_ENV=development

# Crypto
BCRYPT_SALT_ROUNDS=11

# App
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# SameSite of the httpOnly refresh_token cookie: strict (default) | lax | none.
# Use none only when client and auth are on different sites (requires NODE_ENV=production for Secure).
# AUTH_COOKIE_SAMESITE=strict