# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
.next/
out/

# Monorepo task caches (Turbo / Nx)
.turbo/
.nx/cache
.nx/workspace-data

# TypeScript incremental build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# Editor / OS backup files
*.save
*~

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Claude Code personal settings (shared .claude/settings.json stays tracked)
.claude/settings.local.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt
dist

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Database
*.db
*.sqlite

# Docker
.dockerignore

# Initialization script
init-script.sh

repomix-output.xml
# Prisma
**/generated/prisma/

packages/shared/generated
packages/shared/src/prisma/generated/

/prisma/libs/prisma/prisma

# Client e2e (Playwright) artifacts
apps/client_app/e2e/.artifacts/
apps/client_app/playwright-report/
apps/client_app/test-results/

# Load test reports: ignore generated runs, keep the committed baseline and final reports
apps/core_microservice/test/load/reports/*.json
!apps/core_microservice/test/load/reports/baseline.json
!apps/core_microservice/test/load/reports/final.json

# Per-workspace lockfiles (the root package-lock.json is the only lockfile)
apps/*/package-lock.json
packages/*/package-lock.json

# Batch implementation (/impl-batch) gate output and per-lane run evidence
specs/*/impl/baseline/
specs/*/impl/run/
