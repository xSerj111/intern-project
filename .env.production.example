# Production-style env for the container stack (docker-compose.yml + docker-compose.apps.yml).
#   cp .env.production.example .env.production   (gitignored), then replace every CHANGE_ME.
# Used twice: as env_file for auth/core/notifications (and their migrate jobs), and via
# `--env-file .env.production` for the interpolation of docker-compose.yml (infra credentials).
# Hostnames are compose service names. With NODE_ENV=production the services refuse to start
# while any secret they read (JWT, internal token, Postgres, Redis, RabbitMQ, S3, SMTP_PASS)
# still contains CHANGE_ME, or while REDIS_PASSWORD is empty. Grafana refuses it too.
# Generate secrets with e.g. `openssl rand -hex 32`. Full variable reference: .env.example.

NODE_ENV=production
# Optional: debug|info|warn|error, default info in production.
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL (container `postgres`; the init script creates the three databases)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=innogram_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=innogram
DB_NAME_AUTH=innogram_auth
DB_NAME_CORE=innogram_core
DB_NAME_NOTIFICATIONS=innogram_notifications

# ---------------------------------------------------------------------------
# Redis (sessions/blacklists) and redis-cache (core response cache)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Required in production; the redis container enables requirepass with it.
REDIS_PASSWORD=CHANGE_ME
CACHE_REDIS_HOST=redis-cache
CACHE_REDIS_PORT=6379

# ---------------------------------------------------------------------------
# RabbitMQ (container `rabbitmq`). The URL credentials must match the two below.
# ---------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=innogram
RABBITMQ_DEFAULT_PASS=CHANGE_ME
RABBITMQ_URL=amqp://innogram:CHANGE_ME@rabbitmq:5672

# ---------------------------------------------------------------------------
# Secrets (32+ characters each; INTERNAL_API_TOKEN identical for all services)
# ---------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_API_TOKEN=CHANGE_ME

# ---------------------------------------------------------------------------
# Service ports and URLs
# ---------------------------------------------------------------------------
CORE_PORT=3001
AUTH_PORT=3002
NOTIFICATIONS_PORT=3003
CLIENT_PORT=3000

# Server-to-server: auth posts user-created events to core over the compose network.
CORE_SERVICE_URL=http://core:3001
# Notifications reaches auth's internal listener (3012, never published).
AUTH_INTERNAL_URL=http://auth:3012
AUTH_INTERNAL_PORT=3012
# Set by docker-compose.apps.yml for the auth container; listed here for completeness.
AUTH_INTERNAL_HOST=0.0.0.0

# Browser-facing origin of the client (CORS in core, links in notification emails).
CLIENT_URL=http://localhost:3000
# Comma-separated origins allowed for credentialed CORS on auth (the client origin).
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# SameSite of the refresh_token cookie: strict (default) | lax | none.
# Keep strict while client and auth share a site (e.g. localhost, or app.example.com +
# auth.example.com). Use none only when they are on different sites; with
# NODE_ENV=production the cookie is then also Secure, so auth must be served over HTTPS.
# AUTH_COOKIE_SAMESITE=strict

# Client build args (docker-compose.apps.yml): the service URLs baked into the browser
# bundle. They must be reachable from the user's browser, so use published host ports or
# public hostnames, never container names. Defaults http://localhost:300{2,1,3}.
CLIENT_PUBLIC_AUTH_URL=http://localhost:3002
CLIENT_PUBLIC_CORE_URL=http://localhost:3001
CLIENT_PUBLIC_NOTIFICATIONS_URL=http://localhost:3003
# Optional; auth and the client build use it.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# S3 storage (container `seaweedfs`, S3 API on 8333 inside the network, host port 9000)
# ---------------------------------------------------------------------------
S3_ENDPOINT=seaweedfs
S3_PORT=8333
# Browser-facing base for signed and public URLs (the published host port).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_NAME=innogram-assets
S3_PRIVATE_BUCKET_NAME=innogram-private
S3_REGION=us-east-1
S3_USE_SSL=false
UPLOAD_LINK_TTL_SEC=300

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=11

# ---------------------------------------------------------------------------
# Notifications email (container `mailpit`; point at a real SMTP provider in production)
# ---------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Innogram <no-reply@innogram.local>"
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Monitoring profile (`--profile monitoring`); Prometheus targets are set by the overlay
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Must stay false: core refuses to start with it in production.
PERF_INSTRUMENTATION=false
