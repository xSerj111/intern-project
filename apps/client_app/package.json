{
  "name": "client_app",
  "version": "0.0.1",
  "description": "Innogram web client (Next.js App Router)",
  "private": true,
  "scripts": {
    "dev": "next dev --port ${CLIENT_PORT:-3000}",
    "build": "next build",
    "start": "next start --port ${CLIENT_PORT:-3000}",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@repo/contracts": "*",
    "@tanstack/react-query": "^5.103.2",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.59.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "testPathIgnorePatterns": ["/node_modules/", "<rootDir>/e2e/"],
    "modulePathIgnorePatterns": ["<rootDir>/e2e/"]
  }
}
